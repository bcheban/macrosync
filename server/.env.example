# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- market data ----------------------------------------------------------
# Public Binance REST. No API key needed. Set USE_LIVE_MARKET_DATA=false to run
# fully offline against the deterministic simulator.
# data-api.binance.vision is Binance's market-data mirror: identical payloads,
# no key, and not geo-blocked for datacenter IPs (api.binance.com is, which is
# why a serverless deploy silently falls back to the simulator without it).
BINANCE_API_BASE=https://data-api.binance.vision
BINANCE_API_FALLBACK=https://api.binance.com
USE_LIVE_MARKET_DATA=true
MARKET_TIMEOUT_MS=2500
# After every host fails, skip upstream entirely for this long so one
# unreachable exchange cannot turn into a function timeout.
UPSTREAM_COOLDOWN_MS=30000

# Default watchlist. The full tradable universe lives in
# server/src/data/assets.ts and is exposed at GET /api/assets — the dashboard's
# asset switcher can request any subset of it.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,SHIBUSDT,LINKUSDT
# Each requested symbol costs one kline fetch, so requests are capped.
MAX_SYMBOLS_PER_REQUEST=16

# --- AI risk layer --------------------------------------------------------
# Leave both keys empty to use the built-in deterministic risk engine.
# LLM_PROVIDER: auto | anthropic | openai | heuristic
# The dashboard passes ?lang=en|uk to /api/insights; the model is instructed to
# answer in that language, while the rule engine emits translation keys instead.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
