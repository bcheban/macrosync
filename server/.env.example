# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- market data (MEXC) ----------------------------------------------------
# Public MEXC REST. No API key required for market data. Note the interval
# codes differ from other exchanges: the hourly bar is `60m`, and `1h` is
# rejected — see MEXC_INTERVAL in server/src/services/market.service.ts.
#
# There is no simulated fallback: if MEXC cannot be reached the API returns
# nothing rather than inventing prices. GET /api/health reports why.
MEXC_API_BASE=https://contract.mexc.com
MARKET_TIMEOUT_MS=4000
# Concurrent upstream requests. Public endpoints are rate limited per IP, and
# sixteen tracked symbols means sixteen kline calls per refresh.
MARKET_CONCURRENCY=6
# Pause upstream calls for this long after a failure...
UPSTREAM_COOLDOWN_MS=20000
# ...and for longer when MEXC answers 429/418, which is an explicit ban.
RATE_LIMIT_COOLDOWN_MS=60000

# Default watchlist. The full tradable universe lives in
# server/src/data/assets.ts and is exposed at GET /api/assets.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,SHIBUSDT,LINKUSDT
MAX_SYMBOLS_PER_REQUEST=16

# --- news -------------------------------------------------------------------
# NEWS_PROVIDER: auto | cryptopanic | cryptocompare | newsdata | rss
# `auto` picks the first provider that has credentials, and falls back to RSS.
#
# Every hosted crypto-news API now rejects keyless requests (CryptoPanic 403,
# CryptoCompare/CoinDesk 401, CoinGecko PRO-only), so RSS from real newsrooms
# is the default: current, factual, and needs no account.
NEWS_PROVIDER=auto
CRYPTOPANIC_TOKEN=
CRYPTOCOMPARE_API_KEY=
NEWSDATA_API_KEY=
NEWS_RSS_FEEDS=https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml,https://www.coindesk.com/arc/outboundfeeds/rss/
# Headlines move far slower than prices; polling harder only risks a ban.
NEWS_TTL_MS=300000
NEWS_TIMEOUT_MS=6000

# --- economic calendar -------------------------------------------------------
# Real prints, dates, impact ratings, forecasts and prior readings come from
# ForexFactory's public weekly feed — no key. The feed covers the current week
# and rolls over weekly; late in the week the queue legitimately runs short and
# the dashboard says so rather than padding it.
CALENDAR_TTL_MS=1800000
CALENDAR_TIMEOUT_MS=6000

# --- Telegram alerts ---------------------------------------------------------
# Both values are required; with either missing the notifier is inert and never
# touches the network. See "Telegram alerts" in the README for how to get them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Quiet period per asset+strategy after an alert. A score sitting on its
# threshold flips between BUY and WAIT bar to bar; this absorbs that. A genuine
# reversal (BUY -> SELL) ignores the cooldown and always sends.
TELEGRAM_COOLDOWN_MS=5400000
TELEGRAM_TIMEOUT_MS=5000

# --- persistence -------------------------------------------------------------
# Upstash Redis over REST. Provision it from the Vercel marketplace and the
# KV_REST_API_* names are injected automatically; Upstash's own dashboard uses
# the UPSTASH_* names and both are accepted.
#
# Without it the server still runs, but alert de-duplication and the trade
# ledger live in memory and do not survive a cold start — which on serverless
# means the win rate resets and alerts can repeat.
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_PREFIX=macrosync
REDIS_TIMEOUT_MS=4000

# --- autonomous cron ---------------------------------------------------------
# Shared secret for POST /api/cron/signals. The route 404s while unset, so an
# unconfigured deploy cannot be triggered by anyone who reads the source.
CRON_SECRET=
# Strategies the scheduled run evaluates. Fewer means a faster, cheaper run.
CRON_STRATEGIES=scalping,day,swing

# --- global radar ------------------------------------------------------------
# The scheduled run scans the exchange, not the dashboard's asset list. MEXC
# quotes ~1,700 tradable USDT pairs; they are ranked by 24h turnover and swept a
# batch at a time, with a cursor in Redis carrying over between runs.
RADAR_ENABLED=true
# Upper bound on the ranking. The volume floor usually binds first.
RADAR_UNIVERSE_SIZE=150
# Liquidity floor. At $1M only ~60 MEXC pairs qualify — lower it to widen the
# net, at the cost of scanning markets whose spread can exceed the edge.
RADAR_MIN_VOLUME_USD=1000000
# Pairs per run. 18 x 3 strategies takes a few seconds; a full sweep of 60 pairs
# takes four runs, so a five-minute schedule covers the board every 20 minutes.
RADAR_BATCH_SIZE=18
# How long a ranking is reused. Rebuilding mid-rotation would reshuffle it under
# the cursor, so some pairs would come round twice and others never.
RADAR_UNIVERSE_TTL_MS=21600000
# Always scanned, whatever their turnover. Defaults to the dashboard's pairs.
RADAR_ALWAYS_INCLUDE=

# --- alert dispatch ----------------------------------------------------------
# A wide radar can confirm many calls at once. A run sends its highest-conviction
# calls and reports the rest as dropped rather than flooding the channel.
ALERTS_MAX_PER_RUN=6
# Gap between sends — Telegram accepts about one message per second to a chat.
ALERTS_SEND_GAP_MS=1200
# Attempts per message before the call is abandoned for this run.
ALERTS_SEND_RETRIES=3

# Shared secret for POST /api/alerts/test — proves the Telegram path on demand.
ALERTS_TEST_SECRET=

# --- telegram webhook --------------------------------------------------------
# Telegram echoes this in X-Telegram-Bot-Api-Secret-Token on every webhook call.
# The endpoint is a public URL, so this header is the only thing separating a
# real update from a forged subscription. /api/telegram/webhook 404s while unset.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Where Telegram should deliver, if you would rather not pass it as an argument:
#   npm run telegram:webhook --workspace server -- https://your-app.vercel.app
PUBLIC_BASE_URL=

# --- admin -------------------------------------------------------------------
# Guards POST /api/admin/reset, which destroys the trading record. The route
# 404s while unset, and even with the secret it refuses to act without
# ?confirm=RESET — a destructive endpoint that fires on a bare authenticated
# POST is a foot-gun waiting for a mistyped curl.
#   ?scope=ledger (default) clears trades, statistics and alert state
#   ?scope=all    additionally drops every subscriber and their settings
ADMIN_SECRET=

# How far a trade must travel toward its target before its stop is pulled to
# entry, as a fraction. Must be strictly between 0 and 1 — anything else is
# refused with a warning and the default is used.
#   0.5  moved the stop at the halfway mark; on hourly bars the entry and the
#        halfway point sit in the same recent range, so wicks scratched trades
#        that were still working
#   0.75 the current default
# GET /api/admin/analytics reports what the scratched trades did afterwards,
# which is the evidence for moving this again.
BREAKEVEN_THRESHOLD=0.75

# When a trade going nowhere is closed to free its slot, and how far it must
# have travelled to be spared. Both are fractions strictly inside (0,1).
#   STAGNANT_AFTER    fraction of the strategy's max lifetime before the check
#   STAGNANT_PROGRESS fraction of the way to target the trade must have reached
# Expired trades stay out of the win rate, so this cannot flatter the record.
STAGNANT_AFTER=0.5
STAGNANT_PROGRESS=0.3

# --- AI risk layer ----------------------------------------------------------
# Leave both keys empty to use the built-in deterministic risk engine.
# LLM_PROVIDER: auto | anthropic | openai | heuristic
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
