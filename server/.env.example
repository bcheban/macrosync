# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- market data (MEXC) ----------------------------------------------------
# Public MEXC REST. No API key required for market data. Note the interval
# codes differ from other exchanges: the hourly bar is `60m`, and `1h` is
# rejected — see MEXC_INTERVAL in server/src/services/market.service.ts.
#
# There is no simulated fallback: if MEXC cannot be reached the API returns
# nothing rather than inventing prices. GET /api/health reports why.
MEXC_API_BASE=https://api.mexc.com
MARKET_TIMEOUT_MS=4000
# Concurrent upstream requests. Public endpoints are rate limited per IP, and
# sixteen tracked symbols means sixteen kline calls per refresh.
MARKET_CONCURRENCY=6
# Pause upstream calls for this long after a failure...
UPSTREAM_COOLDOWN_MS=20000
# ...and for longer when MEXC answers 429/418, which is an explicit ban.
RATE_LIMIT_COOLDOWN_MS=60000

# Default watchlist. The full tradable universe lives in
# server/src/data/assets.ts and is exposed at GET /api/assets.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,SHIBUSDT,LINKUSDT
MAX_SYMBOLS_PER_REQUEST=16

# --- news -------------------------------------------------------------------
# NEWS_PROVIDER: auto | cryptopanic | cryptocompare | newsdata | rss
# `auto` picks the first provider that has credentials, and falls back to RSS.
#
# Every hosted crypto-news API now rejects keyless requests (CryptoPanic 403,
# CryptoCompare/CoinDesk 401, CoinGecko PRO-only), so RSS from real newsrooms
# is the default: current, factual, and needs no account.
NEWS_PROVIDER=auto
CRYPTOPANIC_TOKEN=
CRYPTOCOMPARE_API_KEY=
NEWSDATA_API_KEY=
NEWS_RSS_FEEDS=https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml,https://www.coindesk.com/arc/outboundfeeds/rss/
# Headlines move far slower than prices; polling harder only risks a ban.
NEWS_TTL_MS=300000
NEWS_TIMEOUT_MS=6000

# --- AI risk layer ----------------------------------------------------------
# Leave both keys empty to use the built-in deterministic risk engine.
# LLM_PROVIDER: auto | anthropic | openai | heuristic
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
