{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }]
}
