# --- API ------------------------------------------------------------------
# Defaults to /api, proxied to the Express server in dev. Set this when the API
# lives on a different origin in production.
# VITE_API_BASE=https://api.macrosync.io

# --- SEO ------------------------------------------------------------------
# Absolute origin the site is deployed to. Feeds canonical URLs, Open Graph
# tags, hreflang alternates, robots.txt and sitemap.xml — all of which need
# absolute URLs. Getting this wrong is the one thing that breaks indexing.
VITE_SITE_URL=https://macrosync.io

# --- Telegram -------------------------------------------------------------
# Public link to the alert bot. The call-to-action renders only when this is
# set, so an unconfigured deploy shows no dead button.
VITE_TELEGRAM_BOT_URL=https://t.me/AyanoxTradeBot

# --- Analytics ------------------------------------------------------------
# GA4 measurement id. Leave empty to disable analytics entirely; the tag is
# never requested when unset, and is also skipped when the browser sends DNT.
VITE_GA_MEASUREMENT_ID=
